{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "node_modules/.cache/typecheck/tests",
    "tsBuildInfoFile": "node_modules/.cache/typecheck/tests.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/__tests__",
    "src/__tests__/helpers",
    "src/types"
  ],
  "exclude": [
    "src/__tests__/*.ts",
    "src/__tests__/fixtures",
    "src/__tests__/photon"
  ],
  "references": [
    {
      "path": "./tsconfig.src.json"
    }
  ]
}
